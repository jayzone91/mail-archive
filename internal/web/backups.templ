package web

import "github.com/jayzone91/mail-archive/internal/backup"
import "strconv"

templ backupsView(jobs []backup.Job) {
	<form class="panel" method="post" action="/backups">
		<button name="mode" value="full">Alle aktiven Postfächer vollständig sichern</button>
		<button name="mode" value="incremental">Alle aktiven Postfächer inkrementell sichern</button>
	</form>
	@jobMonitor("Sicherungsaufträge", "/backups/status", "/backups", backupJobs(jobs))
}

templ backupJobs(jobs []backup.Job) {
	<div data-active-jobs={ strconv.FormatBool(activeBackupJobs(jobs)) }>
		if len(jobs) == 0 {
			<p>Es wurden noch keine Sicherungen gestartet.</p>
		} else {
			<ul class="job-items">
				for _, job := range jobs {
					<li>
						<strong>{ job.Account }</strong>
						if job.Mode == "full" {
							<span>· Vollsicherung</span>
						} else {
							<span>· Inkrementelle Sicherung</span>
						}
						@jobBadge(job.Status)
						<span class="job-count">{ strconv.FormatInt(job.Processed, 10) } verarbeitet</span>
						@jobTimestamps(job.CreatedAt, job.StartedAt, job.FinishedAt)
						if job.Error != "" {
							<p class="alert">{ job.Error }</p>
						}
						if job.Status == "failed" {
							<form method="post" action={ templ.SafeURL("/backups/" + strconv.FormatInt(job.ID, 10) + "/retry") }>
								<button type="submit">Sicherung fortsetzen</button>
							</form>
						}
					</li>
				}
			</ul>
		}
	</div>
}

func activeBackupJobs(jobs []backup.Job) bool {
	for _, job := range jobs {
		if job.Status == "running" || job.Status == "queued" {
			return true
		}
	}
	return false
}
