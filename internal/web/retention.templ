package web

import "strconv"
import "github.com/jayzone91/mail-archive/internal/retention"

templ retentionView(groups []retention.Group) {
	<p>Diese Vorschau zeigt ältere Nachrichten aus dem letzten lokal gespeicherten IMAP-Stand. Sie prüft weder den aktuellen Mailserver noch die Zweitsicherung und löst keine Löschung aus.</p>
	if len(groups) == 0 {
		<p>Es sind keine aktiven Postfächer vorhanden.</p>
	}
	for _, group := range groups {
		<section class="panel">
			<h2>{ group.Account }</h2>
			<p>{ strconv.FormatInt(group.Total,10) } Nachrichten vor { group.Cutoff }</p>
			if len(group.Sample) > 0 {
				<ul>
					for _, item := range group.Sample {
						<li><a href={ templ.SafeURL(archiveURL(item.MessageID)) }>{ item.Folder } · { item.InternalDate }</a></li>
					}
				</ul>
				if group.Total > int64(len(group.Sample)) {
					<p>Die Liste zeigt die ältesten 20 Nachrichten.</p>
				}
			}
		</section>
	}
}
